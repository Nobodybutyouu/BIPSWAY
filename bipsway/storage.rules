rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role == 'admin'
        && isActiveUser();
    }

    match /buildings/{buildingId}/map.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /buildings/{buildingId}/floors/{floorId}/plan.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /events/{eventId}/cover.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /events/{eventId}/speakers/{speakerIndex}.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /personnel/{personnelId}/photo.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /orgChart/{positionId}/photo.jpg {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
